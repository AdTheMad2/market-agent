# Secrets. Never commit. See docs/SPEC.md §9.
.env
.env.*
!.env.example
config/.env
config/.env.*
!config/.env.example

# SQLite sidecars. data/market.db is committed by design (docs/SPEC.md §7);
# a rollback journal committed beside it would be replayed on the next open and
# would silently roll the committed state back.
*.db-journal
*.db-wal
*.db-shm

# Python
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage

# OS
Thumbs.db
desktop.ini
