# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
#
# NEVER pass any of these on a command line — session transcripts are permanent
# on-disk logs. Source them from `.env`, or set them as GitHub Actions secrets.
# See docs/SPEC.md §9.
#
# Names only below. No values, ever, in this file.

# Alpaca — market data. Create a data-only account; no funding required.
# https://alpaca.markets/  → Home → API Keys
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Finnhub — company news, earnings calendar. Free tier, no card.
# https://finnhub.io/register
FINNHUB_API_KEY=

# Marketaux — ticker-tagged news, backup to Finnhub. Free tier, no card.
# https://www.marketaux.com/
MARKETAUX_API_KEY=

# Google Gemini — prose rendering only. Free tier, no card.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# FRED — macro release calendar. Free key.
# https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# Telegram — alert delivery. Create a bot via @BotFather, then get your chat ID
# by messaging the bot and reading https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: a separate chat for dry runs, used by scripts/verify_pipeline.py.
# Falls back to TELEGRAM_CHAT_ID if unset.
TELEGRAM_TEST_CHAT_ID=

# SEC EDGAR requires no key, but its fair-use policy requires a descriptive
# User-Agent identifying the operator. Format: "app-name contact@example.com"
EDGAR_USER_AGENT=
